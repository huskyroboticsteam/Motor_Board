#include "BLDC_SPI.h"

uint32_t read_spi(uint8_t address, uint32_t dataToSend) {
    uint8_t txData[5];  // Transmit buffer
    uint8_t rxData[5] = {0};  // Adjusted receive buffer size
    uint32_t result = 0;

    // Prepare the data to send: address and data
    txData[0] = address;
    txData[1] = (dataToSend >> 24) & 0xFF;
    txData[2] = (dataToSend >> 16) & 0xFF;
    txData[3] = (dataToSend >> 8) & 0xFF;
    txData[4] = dataToSend & 0xFF;

    // Perform SPI transmission and reception
    if (HAL_SPI_TransmitReceive(&hspi1, txData, rxData, 5, HAL_MAX_DELAY) != HAL_OK) {
        Error_Handler(); // Handle errors
    }

    // Ignore the first received byte if it's a dummy byte
    result = (rxData[1] << 24) | (rxData[2] << 16) | (rxData[3] << 8) | rxData[4];

    return result;
}


void write_spi(uint8_t address, uint32_t data) {
    uint8_t txData[5];

    txData[0] = (0x80 | address); // Write command
    txData[1] = (data >> 24) & 0xFF;
    txData[2] = (data >> 16) & 0xFF;
    txData[3] = (data >> 8) & 0xFF;
    txData[4] = (data) & 0xFF;

    HAL_GPIO_WritePin(TMC6100_CS_PORT, TMC6100_CS_PIN, GPIO_PIN_RESET); // CS LOW
    HAL_SPI_Transmit(&hspi1, txData, 5, HAL_MAX_DELAY); // Send data
    HAL_GPIO_WritePin(TMC6100_CS_PORT, TMC6100_CS_PIN, GPIO_PIN_SET);   // CS HIGH
}
